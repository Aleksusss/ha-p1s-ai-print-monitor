extends: default

ignore: |
  .git/

rules:
  document-start: disable
  line-length:
    max: 200
    level: warning
  truthy:
    allowed-values: ["true", "false", "on", "off"]
    check-keys: false
  comments:
    min-spaces-from-content: 1
  indentation:
    spaces: 2
    indent-sequences: consistent
